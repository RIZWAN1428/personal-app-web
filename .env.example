# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# Django
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF — needed once you deploy behind a real domain (Render fills this
# automatically in production via RENDER_EXTERNAL_HOSTNAME, see settings.py)
CSRF_TRUSTED_ORIGINS=

# --- Database (Neon Postgres — see SETUP_MANUAL.md Part 5) ---
# Paste the connection string Neon gives you here. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Local-development-only fallback: if you'd rather run Postgres on your
# own machine instead of using Neon while developing, leave DATABASE_URL
# blank above and fill these in instead.
POSTGRES_DB=personalapp
POSTGRES_USER=personalapp
POSTGRES_PASSWORD=personalapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
